# Plantilla del .env de /opt/siem (Etapa N2). NO se usa tal cual:
# 02-graylog-stack.sh genera /opt/siem/.env (0600, root) con valores aleatorios y guarda la
# contraseña de admin de Graylog en /root/.siem/graylog-admin.txt (0600).
# El .env real NUNCA va al repositorio.
#
# Regenerar GRAYLOG_PASSWORD_SECRET con datos ya creados invalida las sesiones y los secretos
# cifrados que Graylog guarda en MongoDB: se genera una vez y se conserva (el script no lo pisa).

SIEM_IP=10.10.10.55
SIEM_TZ=Europe/Madrid
# Pimienta para cifrar contraseñas y tokens (mínimo 16 caracteres; el script usa 96)
GRAYLOG_PASSWORD_SECRET=CAMBIAR
# SHA-256 de la contraseña de admin:  echo -n 'la-contraseña' | sha256sum | cut -d' ' -f1
GRAYLOG_ROOT_PASSWORD_SHA2=CAMBIAR
# Obligatoria para la imagen de OpenSearch >= 2.12 aunque el plugin de seguridad esté desactivado
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CAMBIAR
# Usuario "elastic" del perfil opcional de Elasticsearch
ELASTIC_PASSWORD=CAMBIAR
# Memoria de la JVM (heap). Regla: <= 50% de la RAM que se le quiera dar al servicio
OS_HEAP=1g
ES_HEAP=1g
