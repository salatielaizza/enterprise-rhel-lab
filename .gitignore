# Secretos y temporales: nunca al repositorio
*.iso
*.qcow2
*.ks
*.dryrun.ks
offline_token
*.env.local
lab_ed25519*
known_hosts_lab
results/facts/*.env

# Informes de auditoría del host: contienen usuario, hostname, IPs/MACs
evidence/
*.bak
*.bak[0-9]*

# Copias de seguridad de los scripts de etapa (cp -a fichero fichero.lab-bak.<fecha>):
# git ya guarda la versión anterior; además, si se cuelan en scripts/stageN/files/,
# 'stageN-setup' los copia al nodo de control (ver troubleshooting/etapa7/04)
*.lab-bak.*

# Ficheros de intercambio de vim (quedan si un vim sigue abierto o se cerró mal)
*.swp
*.swo

# Etapa 8 (VMware): el vault real solo vive en ansible01; informes de PowerCLI
scripts/stage8/files/vmware-lab/inventory/group_vars/all/vault.yml
scripts/stage8/files/vmware-lab/reports/
*.dryrun.KS.CFG
lab_esxi_rsa*

# Etapa N2 (SIEM): el .env real y las contraseñas solo viven en siem01; discos e imágenes exportados
scripts/stageN2/files/graylog/.env
*.vmdk
*.ova
*.rpm
__pycache__/
scripts/ll
